{
  "name": "openjob-api",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start:dev": "nodemon index.js",
    "migrate": "node-pg-migrate",
    "migrate:up": "node -e \"require('dotenv').config(); require('child_process').execSync('npm run migrate up', {stdio: 'inherit'})\"",
    "db:clean": "node -e \"require('./db').query('TRUNCATE TABLE bookmarks, applications, jobs, categories, companies, authentications, users CASCADE').then(() => { console.log('Database telah bersih!'); process.exit(0); });\""
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "joi": "^17.13.1",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.11.5"
  },
  "devDependencies": {
    "node-pg-migrate": "^7.5.2",
    "nodemon": "^3.1.0"
  }
}
